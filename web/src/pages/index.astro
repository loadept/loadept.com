---
import Layout from '../layouts/Layout.astro'
import About from '../components/About.astro'
import SoftwareSection from '../components/SoftwareSection.astro'
import { NotesTree } from '../components/NotesTree'
import ContactSection from '../components/ContactSection.astro'
import { getCollection } from 'astro:content'
import { toPost } from '../lib/posts'

const posts = (await getCollection('posts')).map(toPost).sort((a, b) => (
  a.slug.localeCompare(b.slug)
))

const links = [
  {
    label: "Email",
    text: "hi@loadept.com",
    url: "mailto:hi@loadept.com?subject=Hi Loadept!",
  },
  {
    label: "Github",
    text: "Loadept",
    url: "https://loadept.com/s/gh",
  },
  {
    label: "Linkedin",
    text: "Jesus Gonzalo Machaca Hancco",
    url: "https://loadept.com/s/linkedin",
  },
  {
    label: "Tiktok",
    text: "@loadept",
    url: "https://loadept.com/s/tiktok",
  },
]
---

<Layout
	title="loadept"
	description="Mi sitio web personal, comparto notas y recursos relacionados con el desarrollo de software :) ."
	keywords="notas, go, linux, backend, devops, software development"
>
	<div class="max-w-2xl mx-auto px-6 py-12">
		<About />
		<section class="mt-15 mb-16">
			<h2 class="flex items-center text-2xl font-bold mb-6 border-b border-border pb-3">
				Contenido
			</h2>
			<div class="space-y-4">
				<SoftwareSection />
				<NotesTree client:load posts={posts} />
			</div>
		</section>
		<ContactSection links={links} />
	</div>
</Layout>
