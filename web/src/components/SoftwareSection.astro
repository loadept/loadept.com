---
interface SoftwareItem {
  label: string
  url: string
  description: string
}

const items: SoftwareItem[] = [
  {
    label: "db-mcp",
    description: "Servidor MCP para multiples bases de datos (solo lectura).",
    url: "https://loadept.com/s/uEZQ",
  },
  {
    label: "qtheme",
    description: "Herramienta para gestionar temas del WM qtile.",
    url: "https://loadept.com/s/qmvD",
  },
  {
    label: "cursor-live",
    description: "Mira cómo funcionan los websockets con este experimento.",
    url: "https://live.loadept.com"
  },
  {
    label: "ipseek",
    description: "API gratuita para obtener la información y localización de una IP.",
    url: "https://ipseek.space"
  },
]
---

<div>
  <h2 class="text-primary font-normal text-lg">Software</h2>
  <ul class="ml-6 mt-2 space-y-1">
    {items.map((item) => (
      <li>
        <a href={item.url} target="_blank" class="flex text-foreground font-normal hover:underline">
          {item.label}
        </a>
        <p class="text-muted-foreground text-sm">{item.description}</p>
      </li>
    ))}
  </ul>
</div>
